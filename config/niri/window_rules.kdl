window-rule {
  geometry-corner-radius 12

  clip-to-geometry true
}

window-rule {
    match title="^Open File.*$"
    match title="^Select a File.*$"
    match title="^Save As.*$"
    match title="^File Upload.*$"
    match title=".*wants to save$"
    match title=".*wants to open$"
    match title=".*Minecraft.*"

    open-floating true
}

window-rule {
    match app-id="1password"
    open-floating true
    open-focused true
    block-out-from "screencast"
}

window-rule {
    match title=".*Minecraft.*"
    variable-refresh-rate true
}

layer-rule {
    match namespace="^quickshell-wallpaper$"
    place-within-backdrop true
}

// Wyspa (Quickshell island): the shell sets the blur region itself via
// ext-background-effect; this rule only makes it blur windows (not just the
// backdrop). No `blur true` and no `saturation` here: either one renders over
// the whole full-screen surface whenever the shell sets no region (line mode,
// e.g. over a fullscreen game). The saturation lives in the global `blur`.
layer-rule {
    match namespace="^wyspa$"
    background-effect {
        xray false
    }
}
