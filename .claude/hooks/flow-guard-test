#!/usr/bin/env bash
# Regression net for the flow-* hooks. Runs the real hooks against synthetic
# PreToolUse / SubagentStart / SessionStart payloads in throwaway repos.
#
# Lives beside the hooks on purpose: an enforcement layer whose tests sit in
# /tmp has no regression net at all.
#
# Two lessons are built into this file, both learned the hard way:
#
#   Fixtures are VERIFIED before any assertion runs. An earlier version passed
#   34/34 while `git commit` was silently failing (global commit signing, no
#   agent), so "$WT" was an empty directory and every worktree assertion proved
#   nothing.
#
#   All JSON goes through python3, which the hooks themselves require. A
#   previous version built payloads with `jq`; on a machine where jq was absent
#   it sent empty payloads and reported 29 failures that looked exactly like a
#   real regression. A suite that cannot tell "the system is broken" from "my
#   own tooling is broken" is worse than no suite.
#
# Usage: flow-guard-test        (exit 0 = all green)
set -u

HERE=$(cd "$(dirname "$0")" && pwd)
GUARD=$HERE/flow-guard
STATE=$HERE/flow-state
CONTEXT=$HERE/flow-context
SETTINGS=$(cd "$HERE/.." && pwd)/settings.json
ROOT=${TMPDIR:-/tmp}/flow-hooks-test
export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_SYSTEM=/dev/null
pass=0; fail=0
trap 'chmod -R u+w "$ROOT" 2>/dev/null' EXIT

for dep in python3 git; do
  command -v "$dep" >/dev/null || { echo "MISSING DEPENDENCY: $dep" >&2; exit 1; }
done

report() { if [ "$1" = ok ]; then printf 'PASS  %-60s %s\n' "$2" "${3:-}"; pass=$((pass+1))
  else printf 'FAIL  %-60s %s\n' "$2" "${3:-}"; fail=$((fail+1)); fi; }
fixture_fail() { printf 'FIXTURE FAILED: %s\n' "$1" >&2; exit 1; }

# ---------------------------------------------------------------- payloads
edit_payload() { # cwd file [agent_id] [agent_type] [tool]
  python3 -c '
import json, sys
cwd, f, aid, at, tool = sys.argv[1:6]
p = {"hook_event_name": "PreToolUse", "tool_name": tool, "cwd": cwd,
     "tool_input": {"file_path": f}}
if aid: p["agent_id"] = aid
if at: p["agent_type"] = at
print(json.dumps(p))' "$1" "$2" "${3:-}" "${4:-}" "${5:-Edit}"
}
bash_payload() { # cwd command
  python3 -c '
import json, sys
print(json.dumps({"hook_event_name": "PreToolUse", "tool_name": "Bash",
                  "cwd": sys.argv[1], "tool_input": {"command": sys.argv[2]}}))' "$1" "$2"
}
enter_payload() { # cwd [path]  (no path = creating a new worktree by name)
  python3 -c '
import json, sys
cwd, path = sys.argv[1], sys.argv[2]
ti = {"path": path} if path else {"name": "feat"}
print(json.dumps({"hook_event_name": "PreToolUse", "tool_name": "EnterWorktree",
                  "cwd": cwd, "tool_input": ti}))' "$1" "${2:-}"
}
agent_payload() { # cwd [isolation]
  python3 -c '
import json, sys
cwd, iso = sys.argv[1], sys.argv[2]
ti = {"prompt": "do a thing"}
if iso: ti["isolation"] = iso
print(json.dumps({"hook_event_name": "PreToolUse", "tool_name": "Agent",
                  "cwd": cwd, "tool_input": ti}))' "$1" "${2:-}"
}
event_payload() { # cwd event
  python3 -c '
import json, sys
print(json.dumps({"hook_event_name": sys.argv[2], "cwd": sys.argv[1],
                  "agent_id": "a1", "agent_type": "general-purpose"}))' "$1" "$2"
}

decide() { # payload -> allow | deny | malformed
  local out; out=$(printf '%s' "$1" | "$GUARD" 2>/dev/null)
  if [ -z "$out" ]; then echo allow; else
    printf '%s' "$out" | python3 -c '
import json, sys
try: print(json.load(sys.stdin)["hookSpecificOutput"]["permissionDecision"])
except Exception: print("malformed")'
  fi
}
check() { local got; got=$(decide "$3")
  [ "$got" = "$2" ] && report ok "$1" "$got" || report no "$1" "got=$got want=$2"; }

deny_reason() { printf '%s' "$1" | "$GUARD" 2>/dev/null | python3 -c '
import json, sys
try: print(json.load(sys.stdin)["hookSpecificOutput"]["permissionDecisionReason"])
except Exception: print("")'; }

context_of() { # payload -> injected context text ("" when silent)
  printf '%s' "$1" | "$CONTEXT" 2>/dev/null | python3 -c '
import json, sys
s = sys.stdin.read().strip()
if not s: print("")
else:
    try: print(json.loads(s)["hookSpecificOutput"]["additionalContext"])
    except Exception: print("")'
}

wired() { # event matcher_substring command_substring
  python3 -c '
import json, sys
cfg = json.load(open(sys.argv[1]))
event, matcher, command = sys.argv[2], sys.argv[3], sys.argv[4]
for entry in cfg.get("hooks", {}).get(event, []):
    if matcher and matcher not in (entry.get("matcher") or ""): continue
    for hook in entry.get("hooks", []):
        if command in (hook.get("command") or ""): sys.exit(0)
sys.exit(1)' "$SETTINGS" "$1" "$2" "$3"
}
setting() { # python expression over `cfg` -> exit 0 when truthy
  python3 -c '
import json, sys
cfg = json.load(open(sys.argv[1]))
sys.exit(0 if eval(sys.argv[2]) else 1)' "$SETTINGS" "$1"
}

mkrepo() { mkdir -p "$1" && git -C "$1" init -q -b main \
    && git -C "$1" config user.email t@t.t && git -C "$1" config user.name t \
    && echo hello > "$1/app.py" && git -C "$1" add -A \
    && git -C "$1" commit -q --no-gpg-sign -m init; }

# ------------------------------------------------------------------ fixtures
rm -rf "$ROOT"; mkdir -p "$ROOT"
REPO=$ROOT/repo; WT=$REPO/.claude/worktrees/feat; EXT=$ROOT/external-wt
mkrepo "$REPO" || fixture_fail "could not build $REPO (commit failed?)"
git -C "$REPO" worktree add -q "$WT" -b feat/x || fixture_fail "worktree add"
git -C "$REPO" worktree add -q "$EXT" -b ext/x || fixture_fail "external worktree"
[ -f "$WT/.git" ] || fixture_fail "$WT is not a linked worktree"
[ -f "$EXT/.git" ] || fixture_fail "$EXT is not a linked worktree"
[ "$(git -C "$REPO" rev-list --count HEAD)" = 1 ] || fixture_fail "no commit in fixture"
mkdir -p "$REPO/.flow/plans" "$WT/.flow/sdd" "$REPO/src/.flow/run" "$ROOT/outside"
echo "# spec" > "$WT/spec.md"
report ok "fixtures verified (repo + linked + external worktree + a commit)"

# Payload construction must work before any assertion means anything.
probe=$(edit_payload "$REPO" "$REPO/app.py")
case "$probe" in *'"tool_name": "Edit"'*) : ;; *) fixture_fail "payload builder produced: $probe";; esac
report ok "payload builder works (no jq dependency)"

"$STATE" --cwd "$REPO" init demo >/dev/null || fixture_fail "flow-state init"
"$STATE" --cwd "$REPO" set plan=.flow/plans/p.md worktree="$WT" branch=feat/x \
  base="$(git -C "$REPO" rev-parse HEAD)" stage=implement >/dev/null \
  || fixture_fail "one-call set (plan+worktree+stage ordering scope)"
report ok "set stage=implement with plan+worktree in one call"

echo "=== controller must not write code ==="
check "controller edits code in the worktree" deny "$(edit_payload "$WT" "$WT/app.py")"
check "controller edits code in the main checkout" deny "$(edit_payload "$REPO" "$REPO/app.py")"
check "controller edits with a relative path" deny "$(edit_payload "$REPO" app.py)"
check "controller edits the project's spec.md" deny "$(edit_payload "$WT" "$WT/spec.md")"
check "Write, not just Edit" deny "$(edit_payload "$REPO" "$REPO/app.py" "" "" Write)"
check "subagent edits code" allow "$(edit_payload "$WT" "$WT/app.py" sub-1 general-purpose)"
check "subagent edits spec.md (the spec-sync task)" allow "$(edit_payload "$WT" "$WT/spec.md" sub-1 general-purpose)"
check "fork subagent (controller by proxy)" deny "$(edit_payload "$WT" "$WT/app.py" sub-2 fork)"
check "controller edits .flow/ in the main checkout" allow "$(edit_payload "$REPO" "$REPO/.flow/plans/p.md")"
check "controller edits .flow/sdd/ inside the worktree" allow "$(edit_payload "$WT" "$WT/.flow/sdd/task-1-brief.md")"
check "controller edits outside the repo" allow "$(edit_payload "$REPO" "$ROOT/outside/x.md")"
check "cwd outside the repo, target inside it" deny "$(edit_payload "$ROOT/outside" "$REPO/app.py")"
check "controller edits in an external worktree of this repo" deny "$(edit_payload "$EXT" "$EXT/app.py")"

echo "=== the state file is not hand-editable ==="
check "controller writes state.json" deny "$(edit_payload "$REPO" "$REPO/.flow/run/state.json" "" "" Write)"
check "subagent writes state.json" deny "$(edit_payload "$REPO" "$REPO/.flow/run/state.json" sub-3 general-purpose Write)"
echo '{"stage":"inline"}' > "$REPO/src/.flow/run/state.json"
check "decoy state.json deeper in the tree is ignored" deny "$(edit_payload "$REPO/src" "$REPO/src/app.py")"
rm -rf "$REPO/src/.flow"

echo "=== one workspace per run ==="
check "git worktree add" deny "$(bash_payload "$WT" 'git worktree add ../other -b y')"
check "git worktree  add (double space)" deny "$(bash_payload "$WT" 'git worktree  add ../other -b y')"
check "git worktree add --help (reading docs)" allow "$(bash_payload "$WT" 'git worktree add --help')"
check "echo mentioning worktree add" allow "$(bash_payload "$WT" 'echo "run git worktree add" >> README.md')"
check "EnterWorktree for a NEW worktree" deny "$(enter_payload "$WT")"
check "EnterWorktree re-entering the recorded path" allow "$(enter_payload "$REPO" "$WT")"
check "EnterWorktree re-entering via a ../ path" allow "$(enter_payload "$REPO" "$WT/../feat")"
check "EnterWorktree pointing elsewhere" deny "$(enter_payload "$REPO" "$EXT")"
check "Agent with isolation=worktree" deny "$(agent_payload "$WT" worktree)"
check "Agent without isolation" allow "$(agent_payload "$WT")"
check "unrelated bash command" allow "$(bash_payload "$WT" 'npm test')"
check "git commit (not enforced, by design)" allow "$(bash_payload "$REPO" 'git commit -m x')"

echo "=== deny messages carry the run, not an off switch ==="
r=$(deny_reason "$(edit_payload "$WT" "$WT/app.py")")
case "$r" in *"run 'demo'"*) report ok "deny names the run and its state file";; *) report no "deny lacks run label" "$r";; esac
case "$r" in *"set stage=inline"*|*"flow-state clear"*) report no "deny hands over the disarm command";; *) report ok "deny does not hand over the disarm command";; esac

echo "=== deliberate stand-downs ==="
for stage in inline finish; do
  "$STATE" --cwd "$REPO" set stage=$stage >/dev/null
  check "stage=$stage: controller may edit" allow "$(edit_payload "$WT" "$WT/app.py")"
  check "stage=$stage: worktree add allowed" allow "$(bash_payload "$WT" 'git worktree add ../o')"
done
"$STATE" --cwd "$REPO" set stage=implement >/dev/null

echo "=== never breaks a call it cannot judge ==="
SP=$REPO/.flow/run/state.json; cp "$SP" "$ROOT/state.bak"
for junk in '[1,2]' '{"stage":"impleme' '{"stage":"implement","worktree":5}'; do
  printf '%s' "$junk" > "$SP"
  check "malformed state: $junk" allow "$(edit_payload "$REPO" "$REPO/app.py")"
done
cp "$ROOT/state.bak" "$SP"
check "empty stdin" allow ""
check "non-JSON stdin" allow "not json at all"
check "wrong-typed payload fields" allow '{"tool_name":"Edit","cwd":5,"tool_input":{"file_path":["a"]}}'
check "guard still denies after all that" deny "$(edit_payload "$REPO" "$REPO/app.py")"

echo "=== state file semantics ==="
[ "$("$STATE" --cwd "$WT" get stage)" = implement ] \
  && report ok "worktree and checkout share one state file" || report no "shared state file"
[ "$("$STATE" --cwd "$EXT" path)" = "$SP" ] \
  && report ok "external worktree resolves to the same state file" || report no "external worktree state path"
[ -z "$(git -C "$REPO" status --porcelain -- .flow/run)" ] \
  && report ok "run state is self-ignoring" || report no "run state shows in git status"
out=$("$STATE" --cwd "$REPO" init other 2>&1)
case "$out" in *"already open"*) report ok "init refuses to wipe a run with a workspace";; *) report no "init wiped a live run" "$out";; esac
"$STATE" --cwd "$REPO" set base=deadbeef >/dev/null \
  && report ok "unrelated set is not blocked by an ordering rule" || report no "ordering rule over-reaches"
printf 'garbage' > "$SP"
out=$("$STATE" --cwd "$REPO" init fresh 2>&1)
case "$out" in *"cannot be read"*) report ok "init refuses over an unreadable state file";; *) report no "init overwrote junk state" "$out";; esac
cp "$ROOT/state.bak" "$SP"
out=$("$STATE" --cwd "$REPO" set worktree=rel/path 2>&1)
case "$out" in *absolute*) report ok "relative worktree rejected";; *) report no "relative worktree accepted";; esac

SGD=$ROOT/sgd; mkdir -p "$ROOT/gitdir"
git init -q --separate-git-dir="$ROOT/gitdir/repo.git" "$SGD" 2>/dev/null
[ "$("$STATE" --cwd "$SGD" path)" = "$SGD/.flow/run/state.json" ] \
  && report ok "separate-git-dir keeps state inside the working tree" \
  || report no "separate-git-dir state path" "$("$STATE" --cwd "$SGD" path)"
git -C "$ROOT" init -q --bare bare.git 2>/dev/null
out=$("$STATE" --cwd "$ROOT/bare.git" path 2>&1)
case "$out" in *"$ROOT/.flow"*) report no "bare repo leaked state into the parent";; *) report ok "bare repo refused";; esac
mkdir -p "$ROOT/plain"
out=$("$STATE" --cwd "$ROOT/plain" init x 2>&1)
case "$out" in *Traceback*) report no "no git repo: traceback";; *) report ok "no git repo: clean error";; esac
RO=$ROOT/readonly; mkrepo "$RO" >/dev/null || fixture_fail "readonly repo"; chmod -R a-w "$RO"
out=$("$STATE" --cwd "$RO" init x 2>&1)
case "$out" in *Traceback*) report no "read-only repo: traceback";; *) report ok "read-only repo: clean error";; esac
chmod -R u+w "$RO"

echo "=== ordering and lifecycle ==="
ORD=$ROOT/ord; mkrepo "$ORD" >/dev/null || fixture_fail "ord repo"
"$STATE" --cwd "$ORD" init o >/dev/null
out=$("$STATE" --cwd "$ORD" set stage=implement 2>&1)
case "$out" in *plan*) report ok "implement without a plan is refused";; *) report no "implement accepted with no plan";; esac
out=$("$STATE" --cwd "$ORD" set plan=p.md stage=implement 2>&1)
case "$out" in *workspace*) report ok "implement without a workspace is refused";; *) report no "implement accepted with no workspace";; esac
out=$("$STATE" --cwd "$ORD" set stage=finish 2>&1)
case "$out" in *"nothing has been built"*|*"no workspace"*) report ok "finish without a workspace is refused";; *) report no "finish accepted bare" "$out";; esac
"$STATE" --cwd "$ORD" set stage=inline >/dev/null
"$STATE" --cwd "$ORD" set stage=finish >/dev/null \
  && report ok "inline run may reach finish" || report no "inline run cannot finish"
"$STATE" --cwd "$ORD" set stage=finish >/dev/null \
  && report ok "finish is idempotent (re-running the finish skill)" || report no "second finish wedges"
"$STATE" --cwd "$ORD" task 1 complete "aaa..bbb" >/dev/null
out=$("$STATE" --cwd "$ORD" init again 2>&1)
case "$out" in *"already open"*) report ok "init refuses over a run with only a ledger";; *) report no "init wiped a ledgered run" "$out";; esac
"$STATE" --cwd "$ORD" clear >/dev/null
"$STATE" --cwd "$ORD" clear >/dev/null && report ok "clear is idempotent" || report no "second clear failed"
"$STATE" --cwd "$ORD" init led >/dev/null
"$STATE" --cwd "$ORD" task 2 complete b >/dev/null
"$STATE" --cwd "$ORD" task branch-review complete r >/dev/null
"$STATE" --cwd "$ORD" task 10 pending c >/dev/null
[ "$("$STATE" --cwd "$ORD" get tasks | python3 -c 'import json,sys; print(",".join(t["n"] for t in json.load(sys.stdin)))')" = "2,10,branch-review" ] \
  && report ok "ledger orders numbers first, named gates after" \
  || report no "ledger order" "$("$STATE" --cwd "$ORD" get tasks)"

echo "=== cost and process hygiene ==="
SHIM=$ROOT/shim; mkdir -p "$SHIM"
printf '#!/bin/sh\necho "$@" >> %s/git.log\nexec /usr/bin/git "$@"\n' "$ROOT" > "$SHIM/git"
chmod +x "$SHIM/git"; : > "$ROOT/git.log"
PATH="$SHIM:$PATH" decide "$(edit_payload "$REPO" "$REPO/app.py")" >/dev/null
n=$(wc -l < "$ROOT/git.log")
[ "$n" -le 2 ] && report ok "guard uses at most 2 git calls per invocation" "$n" \
  || report no "guard git calls" "$n"
COLD=$ROOT/cold; mkrepo "$COLD" >/dev/null || fixture_fail "cold repo"
P=$(bash_payload "$COLD" ls)
s=$(date +%s%N); for _ in $(seq 10); do printf '%s' "$P" | "$GUARD" >/dev/null 2>&1; done; e=$(date +%s%N)
avg=$(( (e-s)/10000000 ))
[ "$avg" -le 120 ] && report ok "no-run guard latency" "${avg}ms/call" \
  || report no "no-run guard latency" "${avg}ms/call — investigate before raising this bound"

echo "=== context injection ==="
c=$(context_of "$(event_payload "$WT" SubagentStart)")
case "$c" in *"$WT"*feat/x*) report ok "SubagentStart names workspace and branch";; *) report no "SubagentStart: $c";; esac
"$STATE" --cwd "$REPO" set branch= >/dev/null
c=$(context_of "$(event_payload "$WT" SubagentStart)")
case "$c" in *detached*) report ok "detached run: verifies the tree, no phantom branch";; *) report no "detached contract: $c";; esac
"$STATE" --cwd "$REPO" set branch=feat/x >/dev/null
"$STATE" --cwd "$REPO" task 1 complete "aaa..bbb" >/dev/null
c=$(context_of "$(event_payload "$REPO" SessionStart)")
case "$c" in *"complete: 1"*) report ok "SessionStart re-injects the ledger";; *) report no "SessionStart: $c";; esac
case "$c" in *"re-enter it"*) report ok "SessionStart tells a resumed run to re-enter the worktree";; *) report no "no re-entry hint";; esac
[ -z "$(context_of "$(event_payload "$ROOT/plain" SessionStart)")" ] \
  && report ok "silent with no run" || report no "context with no run"

echo "=== settings.json wiring ==="
for tool in Edit Write EnterWorktree Agent; do
  wired PreToolUse "$tool" flow-guard && report ok "$tool wired to flow-guard" || report no "$tool wired to flow-guard"
done
wired PreToolUse Bash flow-guard && report ok "Bash wired to flow-guard" || report no "Bash wired to flow-guard"
wired SubagentStart "" flow-context && report ok "SubagentStart wired to flow-context" || report no "SubagentStart wired to flow-context"
wired SessionStart "" flow-context && report ok "SessionStart wired to flow-context" || report no "SessionStart wired to flow-context"
setting 'len(cfg.get("permissions",{}).get("allow",[])) >= 4' \
  && report ok "flow-state and the SDD scripts are permission-allowed" || report no "permissions allowlist"
setting 'cfg.get("worktree",{}).get("baseRef") == "head"' \
  && report ok "worktree.baseRef = head" || report no "worktree.baseRef"

printf '\n%d passed, %d failed\n' "$pass" "$fail"
[ "$fail" -eq 0 ]
