#!/usr/bin/env python3
"""UserPromptSubmit hook: stamp every user message with local date and time.

Between turns there is no clock — a 30-second gap and a 30-hour gap look the
same. The timestamp arrives as additionalContext, so elapsed time and
time-of-day become things the agent can reason about instead of guess.

Vendored from https://github.com/VoxCore84/claude-code-timestamp-hook (MIT),
with the payload moved into the documented hookSpecificOutput envelope.
"""

import json
import sys
from datetime import datetime

try:
    json.load(sys.stdin)  # the hook protocol hands the event on stdin
except Exception:
    sys.exit(0)

now = datetime.now()
json.dump(
    {
        "hookSpecificOutput": {
            "hookEventName": "UserPromptSubmit",
            "additionalContext": f"[TIMESTAMP] User message received: {now:%A %Y-%m-%d %H:%M:%S}",
        }
    },
    sys.stdout,
)
