#!/usr/bin/env python3
"""PreToolUse guard for the development-workflow pipeline.

Enforces four things prose demonstrably failed to enforce:

  1. **The controller does not write code.** Edit/Write/MultiEdit/NotebookEdit
     from the main thread are denied once a run has a workspace. Subagents pass
     — they are the ones meant to write. Files under `.flow/` pass (briefs,
     reports, spec, plan) except the run state itself, which governs this guard.

  2. **One workspace per run.** A new `EnterWorktree`, `worktree add`, and an
     `Agent` dispatched with `isolation: "worktree"` are denied once a worktree
     is recorded; re-entering the recorded one by `path` is allowed. A second
     workspace is how a run loses track of where its work went.

  3. **The controller does not poll for a dispatched subagent.** A short-interval
     `ScheduleWakeup` naming an implementer, reviewer, fixer or red-team is
     denied: the harness already re-invokes the session with a
     `<task-notification>` when that work finishes. Each wakeup re-reads the
     whole context, so the polling measured across these transcripts cost
     millions of tokens per run for information that arrived on its own. This
     one runs with or without run state — the first wakeup in the observed
     sessions came at the design stage, before any worktree existed.

  4. **A task gets at most two fix rounds.** The third `fixer` dispatch for the
     same task is denied. Past two, the finding is not a patch away: it is the
     brief or the design, and the next round belongs to the user. Measured
     across these transcripts (deduplicated by tool-call id): 39 tasks went to
     three rounds or more, 29 of them as fix→review→fix loops that a
     "consecutive fixers" rule would miss, the worst eight rounds across two
     hours and forty minutes.

Commit location is NOT enforced here: deciding which tree a `git commit` targets
means parsing arbitrary shell, which produced eleven bypasses and false denials
on documentation. Instead the workspace contract travels with every subagent
(hooks/flow-context), the implementer verifies its tree, and `review-package`
refuses an empty commit range so a misplaced commit surfaces at review.

Not a sandbox: writing code through Bash (`cat > f`, `sed -i`) is not blocked.
Hardening that against yourself is an arms race with no winner.

Fails open by design — malformed state, an unreadable file, any exception: allow.
A guard must never break a session it cannot judge. The one exception is a
missing `agent_id`, which would make an implementer's edits deny; if every
implementer suddenly reports being blocked, suspect that field first.
"""

import importlib.machinery
import importlib.util
import json
import os
import re
import shlex
import sys

HERE = os.path.dirname(os.path.realpath(__file__))
EDIT_TOOLS = {"Edit", "Write", "MultiEdit", "NotebookEdit"}
WORKSPACE_TOOLS = {"EnterWorktree", "Agent", "Bash"}
STOOD_DOWN = {"inline", "finish"}
# Roles this pipeline dispatches. Naming one in a short wakeup is polling for
# work the harness reports by itself.
DISPATCHED_ROLES = ("implementer", "reviewer", "fixer", "red-team", "redteam",
                    "subagent", "docs-researcher", "branch review", "task review")
COMPLETION_WORDS = ("finish", "done", "complete", "report", "verdict", "result",
                    "returned", "came back", "skończy", "zakończy", "gotow")
# Standalone word only: hyphenated compounds ("agents-sdk", "agent-ops",
# "multi-agent") are project and topic names, not a dispatch being waited on.
AGENT_WORD = re.compile(r"(?<![\w-])agents?(?![\w-])", re.IGNORECASE)
# The tool's own sanctioned use while dispatched work runs: a rare fallback
# heartbeat in case the work hangs and never notifies. Below this, it is polling.
FALLBACK_FLOOR_S = 1200
# A task's brief or report names it; either identifies the task a fixer is on.
TASK_KEY = re.compile(r"([^\s`\"']*/)task-(\d+)-(?:brief|report)\.md")
MAX_FIX_ROUNDS = 2
# A "fork" subagent inherits the controller's context and model, so letting it
# write is the controller writing through a proxy.
PROXY_AGENT_TYPES = {"fork"}


def allow():
    sys.exit(0)


def deny(reason):
    print(json.dumps({
        "hookSpecificOutput": {
            "hookEventName": "PreToolUse",
            "permissionDecision": "deny",
            "permissionDecisionReason": reason,
        }
    }))
    sys.exit(0)


def flow_state():
    """The one authority on where run state lives — shared with flow-context."""
    sys.dont_write_bytecode = True
    path = os.path.join(HERE, "flow-state")
    loader = importlib.machinery.SourceFileLoader("flow_state", path)
    spec = importlib.util.spec_from_loader("flow_state", loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


def target_file(payload):
    tool_input = payload.get("tool_input") or {}
    path = tool_input.get("file_path") or tool_input.get("notebook_path") or ""
    if not isinstance(path, str) or not path:
        return ""
    if not os.path.isabs(path):
        path = os.path.join(payload.get("cwd") or os.getcwd(), path)
    return os.path.realpath(path)


def check_edit(payload, module, state, root, worktree, task, target):
    # Before the subagent exemption: nobody edits the run state by hand.
    run_dir = os.path.join(root, ".flow", "run") + os.sep
    if target.startswith(run_dir):
        deny(
            "That file is this run's state — what this guard reads. Editing it by "
            "hand switches enforcement off silently. Only the user decides to move "
            f"a run inline or end it; if you believe one applies, say so. [{task}]"
        )

    if payload.get("agent_id") and (payload.get("agent_type") or "") not in PROXY_AGENT_TYPES:
        allow()  # a real subagent: writing code is its job
    if not any(target.startswith(base + os.sep) for base in {root, worktree}):
        # Could still be another worktree of this same project — those are this
        # run's code too, wherever they live on disk.
        if module.repo_root(os.path.dirname(target)) != root:
            allow()  # not this project's code
    # Bookkeeping in either tree: briefs, reports, review packages, spec, plan.
    for base in {root, worktree}:
        if target.startswith(os.path.join(base, ".flow") + os.sep):
            allow()
    deny(
        "This run's code is written by dispatched implementer subagents, not by "
        "the controller — an implementer starting fresh from a task brief beats a "
        "controller carrying six tasks of history, and your context is for "
        "coordination (subagent-driven-development). Dispatch an implementer. Do "
        "not route around this through Bash: that trades a visible handoff for an "
        "invisible one. This is not yours to override — only the user moves a run "
        f"inline or ends it, so if you believe one applies, say so first. [{task}]"
    )


def creates_worktree(command):
    """True for a real `git … worktree add`, not a mention of one.

    Tokenising respects quotes, so `echo "run git worktree add"` is one token
    and reads as prose, while `git worktree add x` reads as three. A command
    hidden inside `bash -c '…'` is invisible here — same class of limit as the
    removed commit check, and acceptable for a tripwire.
    """
    try:
        tokens = shlex.split(command)
    except ValueError:
        tokens = command.split()
    if "--help" in tokens or "-h" in tokens:
        return False  # reading the docs creates nothing
    for i, token in enumerate(tokens[:-2]):
        if os.path.basename(token) != "git":
            continue
        rest = tokens[i + 1:]
        j = 0
        while j < len(rest) - 1 and rest[j].startswith("-"):
            j += 2 if rest[j] in ("-C", "-c") else 1
        if rest[j:j + 2] == ["worktree", "add"]:
            return True
    return False


def polls_for_agent(text):
    """True when the wakeup is about work a dispatched subagent is doing."""
    low = text.lower()
    if any(role in low for role in DISPATCHED_ROLES):
        return True
    # "agent" alone is too common (a project *about* agents); pair it with a
    # word about the work being over.
    return bool(AGENT_WORD.search(low)) and any(w in low for w in COMPLETION_WORDS)


def check_wakeup(payload):
    """Deny a short wakeup scheduled to check on a dispatched subagent."""
    tool_input = payload.get("tool_input") or {}
    if tool_input.get("stop"):
        allow()  # ending a loop is always fine
    delay = tool_input.get("delaySeconds")
    if not isinstance(delay, (int, float)) or isinstance(delay, bool):
        allow()  # nothing to judge
    if delay >= FALLBACK_FLOOR_S:
        allow()  # the sanctioned fallback heartbeat, not polling
    text = " ".join(str(tool_input.get(key) or "") for key in ("reason", "prompt"))
    if not polls_for_agent(text):
        allow()
    deny(
        f"That subagent already wakes you: when it finishes, the harness re-invokes "
        f"this session with a <task-notification>. A {int(delay)}s wakeup to check on "
        "it turns one dispatch into a loop — every wakeup re-reads your whole "
        "context, and in this setup's own transcripts that cost millions of tokens "
        "per run for an answer that arrived by itself 30 seconds later. End the turn "
        "instead: say what you dispatched and stop. A turn with no visible output is "
        "correct here. ListAgents is not a waiting mechanism either. If you want a "
        f"net against work that hangs and never notifies, one wakeup at "
        f"{FALLBACK_FLOOR_S}s or more is the sanctioned form."
    )


def fix_rounds_file(root):
    return os.path.join(root, ".flow", "run", "fix-rounds.json")


def check_fix_rounds(payload, root, task):
    """Deny the third fix round on one task, however the rounds were interleaved."""
    # Returns instead of allow(): the workspace check still has to run after it.
    tool_input = payload.get("tool_input") or {}
    if tool_input.get("subagent_type") != "fixer":
        return
    match = TASK_KEY.search(tool_input.get("prompt") or "")
    if not match:
        # Nothing to attribute the round to. The dispatch table says a fixer
        # prompt carries the brief path; without it this cap cannot see the task.
        return
    key = f"{match.group(1)}|{match.group(2)}"
    path = fix_rounds_file(root)
    try:
        with open(path, encoding="utf-8") as handle:
            rounds = json.load(handle)
        if not isinstance(rounds, dict):
            rounds = {}
    except (OSError, ValueError):
        rounds = {}
    count = rounds.get(key, 0) + 1
    rounds[key] = count
    try:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        tmp = path + ".tmp"
        with open(tmp, "w", encoding="utf-8") as handle:
            json.dump(rounds, handle)
        os.replace(tmp, path)
    except OSError:
        pass  # counting is best-effort; never break the dispatch over bookkeeping
    if count <= MAX_FIX_ROUNDS:
        return
    deny(
        f"Fix round {count} on task {match.group(2)}. Two rounds did not close it, "
        "so the next patch will not either — what is failing is the brief or the "
        "design, not the code, and each further round pays a fresh fixer, a fresh "
        "review and your context. In this setup's own history 39 tasks went past "
        "two rounds, the worst eight times in under three hours, each round fixing "
        "the next variant of the same defect. Stop and put it to the user: what "
        "the reviewer keeps finding, what the brief actually requires, and whether "
        "the task needs re-briefing, re-planning, or a stronger implementer model. "
        "If they hear all that and still want another round, that is their call to "
        f"make out loud — the counter is {fix_rounds_file(root)}, and clearing this "
        "task's entry is something you do on their say-so, never on your own to get "
        f"past this message. [{task}]"
    )


def check_workspace(payload, state, worktree, task):
    tool = payload.get("tool_name")
    tool_input = payload.get("tool_input") or {}
    if tool == "EnterWorktree":
        path = tool_input.get("path")
        if isinstance(path, str) and path and os.path.realpath(path) == os.path.realpath(worktree):
            allow()  # re-entering the recorded workspace: the way back in
    elif tool == "Agent":
        if tool_input.get("isolation") != "worktree":
            allow()
    else:  # Bash
        command = tool_input.get("command")
        if not isinstance(command, str) or "worktree" not in command:
            allow()
        if not creates_worktree(command):
            allow()
    deny(
        f"This run already has a workspace: {worktree}. A second one is how a run "
        "loses track of where its work went — an isolated agent's commits never "
        "reach this branch. Use the recorded workspace: `EnterWorktree` with "
        f"`path: \"{worktree}\"` to move this session into it, or `git -C` to act "
        f"on it. If it is genuinely gone, say so — do not relabel the run. [{task}]"
    )


def main():
    try:
        payload = json.load(sys.stdin)
    except ValueError:
        allow()
    cwd = payload.get("cwd")
    cwd = cwd if isinstance(cwd, str) and cwd else os.getcwd()

    tool = payload.get("tool_name")
    if tool == "ScheduleWakeup":
        # Judged without run state: the polling starts at the design stage,
        # before a worktree exists.
        check_wakeup(payload)
        allow()

    module = flow_state()
    target = target_file(payload) if tool in EDIT_TOOLS else ""

    root = module.repo_root(cwd)
    state = module.load_at(root) if root else None
    if not state and target:
        # A session whose cwd sits outside the repository (multi-root workspace,
        # --add-dir, launched from a parent) still edits files inside it.
        root = module.repo_root(os.path.dirname(target))
        state = module.load_at(root) if root else None
    if not state:
        allow()
    worktree = state.get("worktree")
    if not worktree:
        allow()  # no workspace recorded yet — nothing to enforce against
    if state.get("stage") in STOOD_DOWN:
        allow()

    worktree = os.path.realpath(worktree)
    task = f"run '{state.get('task') or 'unnamed'}': {module.state_file(root)}"
    if tool in EDIT_TOOLS:
        if not target:
            allow()
        check_edit(payload, module, state, root, worktree, task, target)
    elif tool in WORKSPACE_TOOLS:
        if tool == "Agent":
            check_fix_rounds(payload, root, task)
        check_workspace(payload, state, worktree, task)
    allow()


if __name__ == "__main__":
    try:
        main()
    except SystemExit:
        raise
    except Exception:  # a guard that crashes must not break the tool call
        allow()
