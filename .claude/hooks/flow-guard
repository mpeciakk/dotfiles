#!/usr/bin/env python3
"""PreToolUse guard for the development-workflow pipeline.

Enforces three things:

  1. **One workspace per run.** A new `EnterWorktree`, `worktree add`, and an
     `Agent` dispatched with `isolation: "worktree"` are denied once a worktree
     is recorded; re-entering the recorded one by `path` is allowed. A second
     workspace is how a run loses track of where its work went.

  2. **The controller does not poll for a dispatched subagent.** A short-interval
     `ScheduleWakeup` naming an implementer, reviewer or red-team is denied: the
     harness already re-invokes the session with a `<task-notification>` when
     that work finishes, and each wakeup re-reads the whole context. This one
     runs with or without run state.

  3. **Nobody edits the run state by hand.** Edit/Write on `.flow/run/` is
     denied while a run has a workspace; `flow-state` is the way to change it.

The controller may edit code: one writer per tree is the skill's rule
(subagent-driven-development), not this guard's.

Commit location is NOT enforced here: deciding which tree a `git commit` targets
means parsing arbitrary shell, which produced eleven bypasses and false denials
on documentation. Instead the workspace contract travels with every subagent
(hooks/flow-context), the implementer verifies its tree, and `review-package`
refuses an empty commit range so a misplaced commit surfaces at review.

Fails open by design — malformed state, an unreadable file, any exception: allow.
A guard must never break a session it cannot judge.
"""

import importlib.machinery
import importlib.util
import json
import os
import re
import shlex
import sys

HERE = os.path.dirname(os.path.realpath(__file__))
EDIT_TOOLS = {"Edit", "Write", "MultiEdit", "NotebookEdit"}
WORKSPACE_TOOLS = {"EnterWorktree", "Agent", "Bash"}
STOOD_DOWN = {"inline", "finish"}
# Roles this pipeline dispatches. Naming one in a short wakeup is polling for
# work the harness reports by itself.
DISPATCHED_ROLES = ("implementer", "reviewer", "fixer", "red-team", "redteam",
                    "subagent", "docs-researcher", "branch review", "task review")
COMPLETION_WORDS = ("finish", "done", "complete", "report", "verdict", "result",
                    "returned", "came back", "skończy", "zakończy", "gotow")
# Standalone word only: hyphenated compounds ("agents-sdk", "agent-ops",
# "multi-agent") are project and topic names, not a dispatch being waited on.
AGENT_WORD = re.compile(r"(?<![\w-])agents?(?![\w-])", re.IGNORECASE)
# The tool's own sanctioned use while dispatched work runs: a rare fallback
# heartbeat in case the work hangs and never notifies. Below this, it is polling.
FALLBACK_FLOOR_S = 1200


def allow():
    sys.exit(0)


def deny(reason):
    print(json.dumps({
        "hookSpecificOutput": {
            "hookEventName": "PreToolUse",
            "permissionDecision": "deny",
            "permissionDecisionReason": reason,
        }
    }))
    sys.exit(0)


def flow_state():
    """The one authority on where run state lives — shared with flow-context."""
    sys.dont_write_bytecode = True
    path = os.path.join(HERE, "flow-state")
    loader = importlib.machinery.SourceFileLoader("flow_state", path)
    spec = importlib.util.spec_from_loader("flow_state", loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


def target_file(payload):
    tool_input = payload.get("tool_input") or {}
    path = tool_input.get("file_path") or tool_input.get("notebook_path") or ""
    if not isinstance(path, str) or not path:
        return ""
    if not os.path.isabs(path):
        path = os.path.join(payload.get("cwd") or os.getcwd(), path)
    return os.path.realpath(path)


def check_run_state(root, task, target):
    run_dir = os.path.join(root, ".flow", "run") + os.sep
    if target.startswith(run_dir):
        deny(
            "That file is this run's state. Editing it by hand changes what every "
            "hook and resumed session believes about the run. Use `flow-state`; "
            f"only the user decides to move a run inline or end it. [{task}]"
        )


def creates_worktree(command):
    """True for a real `git … worktree add`, not a mention of one.

    Tokenising respects quotes, so `echo "run git worktree add"` is one token
    and reads as prose, while `git worktree add x` reads as three. A command
    hidden inside `bash -c '…'` is invisible here — same class of limit as the
    removed commit check, and acceptable for a tripwire.
    """
    try:
        tokens = shlex.split(command)
    except ValueError:
        tokens = command.split()
    if "--help" in tokens or "-h" in tokens:
        return False  # reading the docs creates nothing
    for i, token in enumerate(tokens[:-2]):
        if os.path.basename(token) != "git":
            continue
        rest = tokens[i + 1:]
        j = 0
        while j < len(rest) - 1 and rest[j].startswith("-"):
            j += 2 if rest[j] in ("-C", "-c") else 1
        if rest[j:j + 2] == ["worktree", "add"]:
            return True
    return False


def polls_for_agent(text):
    """True when the wakeup is about work a dispatched subagent is doing."""
    low = text.lower()
    if any(role in low for role in DISPATCHED_ROLES):
        return True
    # "agent" alone is too common (a project *about* agents); pair it with a
    # word about the work being over.
    return bool(AGENT_WORD.search(low)) and any(w in low for w in COMPLETION_WORDS)


def check_wakeup(payload):
    """Deny a short wakeup scheduled to check on a dispatched subagent."""
    tool_input = payload.get("tool_input") or {}
    if tool_input.get("stop"):
        allow()  # ending a loop is always fine
    delay = tool_input.get("delaySeconds")
    if not isinstance(delay, (int, float)) or isinstance(delay, bool):
        allow()  # nothing to judge
    if delay >= FALLBACK_FLOOR_S:
        allow()  # the sanctioned fallback heartbeat, not polling
    text = " ".join(str(tool_input.get(key) or "") for key in ("reason", "prompt"))
    if not polls_for_agent(text):
        allow()
    deny(
        f"That subagent already wakes you: when it finishes, the harness re-invokes "
        f"this session with a <task-notification>. A {int(delay)}s wakeup to check on "
        "it turns one dispatch into a loop — every wakeup re-reads your whole "
        "context, and in this setup's own transcripts that cost millions of tokens "
        "per run for an answer that arrived by itself 30 seconds later. End the turn "
        "instead: say what you dispatched and stop. A turn with no visible output is "
        "correct here. ListAgents is not a waiting mechanism either. If you want a "
        f"net against work that hangs and never notifies, one wakeup at "
        f"{FALLBACK_FLOOR_S}s or more is the sanctioned form."
    )


def check_workspace(payload, state, worktree, task):
    tool = payload.get("tool_name")
    tool_input = payload.get("tool_input") or {}
    if tool == "EnterWorktree":
        path = tool_input.get("path")
        if isinstance(path, str) and path and os.path.realpath(path) == os.path.realpath(worktree):
            allow()  # re-entering the recorded workspace: the way back in
    elif tool == "Agent":
        if tool_input.get("isolation") != "worktree":
            allow()
    else:  # Bash
        command = tool_input.get("command")
        if not isinstance(command, str) or "worktree" not in command:
            allow()
        if not creates_worktree(command):
            allow()
    deny(
        f"This run already has a workspace: {worktree}. A second one is how a run "
        "loses track of where its work went — an isolated agent's commits never "
        "reach this branch. Use the recorded workspace: `EnterWorktree` with "
        f"`path: \"{worktree}\"` to move this session into it, or `git -C` to act "
        f"on it. If it is genuinely gone, say so — do not relabel the run. [{task}]"
    )


def main():
    try:
        payload = json.load(sys.stdin)
    except ValueError:
        allow()
    cwd = payload.get("cwd")
    cwd = cwd if isinstance(cwd, str) and cwd else os.getcwd()

    tool = payload.get("tool_name")
    if tool == "ScheduleWakeup":
        # Judged without run state: the polling starts at the design stage,
        # before a worktree exists.
        check_wakeup(payload)
        allow()

    module = flow_state()
    target = target_file(payload) if tool in EDIT_TOOLS else ""

    root = module.repo_root(cwd)
    state = module.load_at(root) if root else None
    if not state and target:
        # A session whose cwd sits outside the repository (multi-root workspace,
        # --add-dir, launched from a parent) still edits files inside it.
        root = module.repo_root(os.path.dirname(target))
        state = module.load_at(root) if root else None
    if not state:
        allow()
    worktree = state.get("worktree")
    if not worktree:
        allow()  # no workspace recorded yet — nothing to enforce against
    if state.get("stage") in STOOD_DOWN:
        allow()

    worktree = os.path.realpath(worktree)
    task = f"run '{state.get('task') or 'unnamed'}': {module.state_file(root)}"
    if tool in EDIT_TOOLS:
        if not target:
            allow()
        check_run_state(root, task, target)
    elif tool in WORKSPACE_TOOLS:
        check_workspace(payload, state, worktree, task)
    allow()


if __name__ == "__main__":
    try:
        main()
    except SystemExit:
        raise
    except Exception:  # a guard that crashes must not break the tool call
        allow()
