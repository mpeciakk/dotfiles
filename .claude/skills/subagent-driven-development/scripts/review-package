#!/usr/bin/env bash
# Generate a review package: commit list, stat summary, and the net
# diff with extended context, written to a file the reviewer reads in one
# call. Using the recorded per-task BASE (not HEAD~1) keeps multi-commit
# tasks intact.
#
# Usage: review-package BASE HEAD [OUTFILE]
# Default OUTFILE: <repo-root>/.flow/sdd/review-<base7>..<head7>.diff
# (named per range, so a re-review after fixes gets a distinct fresh file).
set -euo pipefail

if [ $# -lt 2 ] || [ $# -gt 3 ]; then
  echo "usage: review-package BASE HEAD [OUTFILE]" >&2
  exit 2
fi

base=$1
head=$2

git rev-parse --verify --quiet "$base" >/dev/null || { echo "bad BASE: $base" >&2; exit 2; }
git rev-parse --verify --quiet "$head" >/dev/null || { echo "bad HEAD: $head" >&2; exit 2; }

if [ $# -eq 3 ]; then
  out=$3
  caller_chose_path=1
else
  caller_chose_path=0
  dir=$("$(cd "$(dirname "$0")" && pwd)/sdd-workspace")
  out="$dir/review-$(git rev-parse --short "$base")..$(git rev-parse --short "$head").diff"
fi

{
  echo "# Review package: ${base}..${head}"
  echo
  echo "## Commits"
  git log --oneline "${base}..${head}"
  echo
  echo "## Files changed"
  git diff --stat "${base}..${head}"
  echo
  echo "## Diff"
  git diff -U10 "${base}..${head}"
} > "$out"

# stdout is the package path and nothing else, so `pkg=$(review-package ...)`
# is safe; the size note goes to stderr.
commits=$(git rev-list --count "${base}..${head}")

# An empty range is never a reviewable task: either the implementer's commits
# landed in another working tree (a resumed run whose session cwd is the main
# checkout is the usual cause) or the wrong base was passed. Failing loudly
# beats handing a reviewer an empty diff, which reads as "nothing wrong".
if [ "$commits" -eq 0 ]; then
  # Only clean up a path this script chose; a caller-supplied OUTFILE may be
  # something they already had.
  [ "$caller_chose_path" -eq 0 ] && rm -f "$out"
  echo "no commits in ${base}..${head} — nothing to review. The implementer's
commits are not in this working tree ($(git rev-parse --show-toplevel)), or BASE
is wrong. Find them before reviewing: \`git log --all --oneline -5\`." >&2
  exit 4
fi

echo "wrote ${out}: ${commits} commit(s), $(wc -c < "$out" | tr -d ' ') bytes" >&2
echo "$out"
