#!/usr/bin/env bash
# Resolve and ensure the working-tree directory SDD uses for its short-lived
# artifacts: task briefs, implementer reports, and review packages. Print the
# directory's absolute path. (Run progress lives elsewhere, in the run state
# file that ~/.claude/hooks/flow-state owns — it has to survive this directory
# being wiped, and it is shared with the main checkout.)
#
# In the working tree rather than under .git/, because agent writes to .git/ are
# denied — which would block an implementer from writing its report. A
# self-ignoring .gitignore keeps it out of `git status` without touching any
# tracked file. Single source of truth, so task-brief and review-package cannot
# drift apart.
#
# Usage: sdd-workspace
set -euo pipefail

root=$(git rev-parse --show-toplevel)
dir="$root/.flow/sdd"
mkdir -p "$dir"
printf '*\n' > "$dir/.gitignore"
cd "$dir" && pwd
