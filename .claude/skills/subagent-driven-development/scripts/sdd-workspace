#!/usr/bin/env bash
# Resolve and ensure the working-tree directory SDD uses for its short-lived
# artifacts: task briefs, implementer reports, and review packages. Print the
# directory's absolute path. (Run progress lives elsewhere, in the run state
# file that ~/.claude/hooks/flow-state owns — it has to survive this directory
# being wiped, and it is shared with the main checkout.)
#
# In the working tree rather than under .git/, because agent writes to .git/ are
# denied — which would block an implementer from writing its report. The
# directory is scratch: everything in it is ignored and goes with the worktree.
# The record of a run is the plan, the spec and the commits. Single source of
# truth, so task-brief and review-package cannot drift apart.
#
# Usage: sdd-workspace
set -euo pipefail

root=$(git rev-parse --show-toplevel)
dir="$root/.flow/sdd"
mkdir -p "$dir"
# Only when absent: projects from the archiving era track a `*.diff` version,
# and rewriting a tracked file would leave the tree dirty for the implementer.
[ -e "$dir/.gitignore" ] || printf '*\n' > "$dir/.gitignore"
cd "$dir" && pwd
