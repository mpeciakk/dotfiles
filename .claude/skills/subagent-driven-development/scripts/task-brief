#!/usr/bin/env bash
# Extract one task's full text from an implementation plan into a file the
# implementer reads in one call, so the task text never has to be pasted
# through the controller's context.
#
# Every heading-level-2-or-shallower preamble section that appears before the
# first Task heading is prepended to every brief, in document order — not just
# "## Global Constraints" by name, but any other shared section a plan author
# adds (a setup snippet, a testing approach) that a task's own steps refer back
# to in prose. A brief that silently drops such a section is unrecoverable from
# the brief text alone: a real run's Task 1 said "run the snippet above" and
# the generated brief never carried the snippet, caught only because the tool
# it needed happened to already be installed.
#
# Section boundaries are heading-LEVEL aware: a task ends at the next heading
# of the same or shallower level, so `#### Implementation notes` inside a task
# stays part of it while the next `### Task N+1` or a trailing `## Verification`
# does not. Getting this wrong truncates a brief silently, which is worse than
# failing — the implementer invents the missing steps and the reviewer grades
# the same truncated text.
#
# Usage: task-brief PLAN_FILE TASK_NUMBER [OUTFILE]
# Default OUTFILE: <repo-root>/.flow/sdd/<plan-basename>/task-<N>-brief.md
# (namespaced per plan, so two plans in one working tree cannot overwrite
# each other's briefs).
#
# stdout is the brief's path and nothing else, so `brief=$(task-brief ...)`
# is safe; notes and warnings go to stderr.
set -euo pipefail

if [ $# -lt 2 ] || [ $# -gt 3 ]; then
  echo "usage: task-brief PLAN_FILE TASK_NUMBER [OUTFILE]" >&2
  exit 2
fi

plan=$1
n=$2
[ -f "$plan" ] || { echo "no such plan file: $plan" >&2; exit 2; }

if [ $# -eq 3 ]; then
  out=$3
else
  base=$(basename "$plan"); base=${base%.md}
  dir="$("$(cd "$(dirname "$0")" && pwd)/sdd-workspace")/$base"
  mkdir -p "$dir"
  out="$dir/task-${n}-brief.md"
fi

# `Task 1` must not match `Task 10` or `Task 1.5`.
awk -v n="$n" '
  /^```/ { infence = !infence; if (intask) print; next }
  !infence && /^#+[ \t]/ {
    match($0, /^#+/); lvl = RLENGTH
    if ($0 ~ ("^#+[ \t]+Task[ \t]+" n "([^0-9.]|$)")) { intask = 1; tasklvl = lvl }
    else if (intask && lvl <= tasklvl) { exit }
  }
  intask { print }
' "$plan" > "$out"

if [ ! -s "$out" ]; then
  echo "task ${n} not found in ${plan} (no heading matching 'Task ${n}')" >&2
  exit 3
fi

# Every section at heading level >= 2 before the first Task heading is
# preamble — Global Constraints and anything else a plan author added at that
# level. Capture starts at the first such heading (excluding the level-1
# document title) and runs until a `Task N` heading of any level, so multiple
# preamble sections are concatenated in document order rather than only the
# one literally named "Global Constraints".
preamble=$(awk '
  /^```/ { infence = !infence; if (started) print; next }
  !infence && /^---[ \t]*$/ { next }
  !infence && /^#+[ \t]/ {
    match($0, /^#+/); lvl = RLENGTH
    if ($0 ~ /^#+[ \t]+Task[ \t]+[0-9]/) exit
    if (lvl >= 2) started = 1
  }
  started { print }
' "$plan")

if [ -n "$preamble" ]; then
  printf '%s\n\n---\n\n%s\n' "$preamble" "$(cat "$out")" > "$out.tmp"
  mv "$out.tmp" "$out"
else
  echo "note: ${plan} has no heading-level preamble section before its tasks —
if project-wide requirements live somewhere the plan's tasks reference, paste
them into the dispatch yourself" >&2
fi

echo "wrote ${out}: $(wc -l < "$out" | tr -d ' ') lines" >&2
echo "$out"
